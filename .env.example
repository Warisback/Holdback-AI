# Copy to .env and fill in. .env is gitignored; this example is committed.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:5000/callback
XERO_SCOPES=openid profile email offline_access accounting.settings.read accounting.contacts.read accounting.invoices
XERO_TENANT_ID=
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET=change-me-to-a-random-64-char-hex
FLASK_DEBUG=0
EXTRACT_PROVIDER=gemini
EXTRACT_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
